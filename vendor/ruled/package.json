{
  "name": "@ruled/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Ruled: a hairline bento-grid design system (Lilac / Lime).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && tsc --noEmit && vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
