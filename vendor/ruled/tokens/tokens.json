{
  "$description": "Ruled design tokens: Lilac / Lime theme. W3C Design Tokens (DTCG) format. Run `npm run tokens` to regenerate src/styles/tokens.css and src/tokens.ts.",
  "color": {
    "$type": "color",
    "ink": { "$value": "#0A0A0A", "$description": "Text, rules, inverted (hover) cells" },
    "paper": { "$value": "#FFFFFF", "$description": "Default cell background" },
    "wash": { "$value": "#F6F3FC", "$description": "Label column background" },
    "tint": { "$value": "#E8E1F6", "$description": "Media fills and highlight cells" },
    "tint-strong": { "$value": "#CBBFEA", "$description": "Placeholder strokes, soft rules" },
    "hairline": { "$value": "#E2DAF2", "$description": "Row dividers inside a cell" },
    "muted": { "$value": "#5C5C5C", "$description": "Labels and secondary text (5.9:1 on wash)" },
    "body": { "$value": "#3A3A3A", "$description": "Paragraph text" },
    "accent": { "$value": "#CCFF00", "$description": "Neon lime. Primary action, brand mark, section tags only" },
    "on-accent": { "$value": "{color.ink}", "$description": "Text on accent. Never white on lime" },
    "alt": {
      "klein": { "$value": "#002FA7", "$description": "Alternate accent; pair with white text" },
      "pink": { "$value": "#FF2E88", "$description": "Alternate accent; pair with ink text" }
    }
  },
  "rule": {
    "color": { "$type": "color", "$value": "{color.ink}", "$description": "Structural rule between cells" },
    "color-soft": { "$type": "color", "$value": "{color.tint-strong}", "$description": "Softer rule option for quieter pages" },
    "width": { "$type": "dimension", "$value": "1px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Ruled has no rounded corners" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "40px" },
    "2xl": { "$value": "64px" }
  },
  "cell": {
    "padding": {
      "$type": "dimension",
      "sm": { "$value": "{space.md}" },
      "md": { "$value": "{space.lg}", "$description": "Default cell padding" },
      "lg": { "$value": "{space.xl}", "$description": "Hero and quote cells" }
    }
  },
  "control": {
    "height": { "$type": "dimension", "$value": "52px", "$description": "Buttons and inputs" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "thin": { "$value": 200 },
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 }
    }
  },
  "type": {
    "$type": "typography",
    "display-xl": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.thin}", "fontSize": "136px", "lineHeight": 0.9, "letterSpacing": "-0.06em" }, "$description": "Hero headline; scales down to 56px with the viewport" },
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.thin}", "fontSize": "64px", "lineHeight": 1, "letterSpacing": "-0.05em" }, "$description": "Stats and figures" },
    "heading": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.thin}", "fontSize": "44px", "lineHeight": 1, "letterSpacing": "-0.045em" } },
    "title": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.regular}", "fontSize": "20px", "lineHeight": 1.3, "letterSpacing": "-0.02em" } },
    "body-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.light}", "fontSize": "18px", "lineHeight": 1.5, "letterSpacing": "0em" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": "{font.weight.light}", "fontSize": "15px", "lineHeight": 1.5, "letterSpacing": "0em" } },
    "label": { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": "{font.weight.regular}", "fontSize": "12px", "lineHeight": 1.4, "letterSpacing": "0.06em" }, "$description": "Set in capitals" }
  },
  "motion": {
    "duration": { "fast": { "$type": "duration", "$value": "150ms" } },
    "easing": { "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] } }
  },
  "breakpoint": {
    "collapse": { "$type": "dimension", "$value": "900px", "$description": "Grids collapse to one column below this width. Media queries can't read CSS variables, so grid.css repeats this value." }
  }
}
